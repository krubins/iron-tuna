# Local validation tooling only — the deployed app has no build step (see HANDOFF.md).
# These are used to syntax-check index.html before pushing; they must not deploy.
node_modules/
package.json
package-lock.json
scratch-*
.dev.vars
# wrangler's local state (miniflare's D1 sqlite, caches) — created by
# `wrangler dev --local` and `d1 execute --local`, never deployed.
.wrangler/

# Raw sportsbook pulls and the merged source files they produce. These are
# inputs to tools/vegas-to-projections.mjs + tools/merge-projections.mjs; the
# committed artifact is the updated PROJECTIONS block in _worker.js, not the
# scratch data. tools/odds.example/ IS committed as schema documentation.
tools/odds/
tools/sources/
