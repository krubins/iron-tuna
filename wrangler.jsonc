{
  "name": "iron-tuna",
  "main": "_worker.js",
  "compatibility_date": "2025-05-01",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "LLM_PROVIDER": "anthropic", "LLM_MODEL": "claude-sonnet-4-6", "POST_DRAFT_OPEN": "1" },
  "d1_databases": [
    { "binding": "LEADS_DB", "database_name": "iron-tuna-leads", "database_id": "75f7c43a-69cc-48eb-aa78-6ecfd91af2fb" }
  ],
  "triggers": {
    // ONE trigger: the quarter-hour tick. scheduled() in _worker.js hands it to
    // runScheduledTick, which reads JOB_SCHEDULE in New York time (days, hours
    // and quarter-hour minutes) and runs what is due through the job log, then
    // the content desk. The quarter-hour cadence is what makes a Sunday 12:15 PM
    // and a 7:30 PM editorial slot possible in Eastern time without a UTC cron
    // that drifts an hour every November. See HANDOFF.md "The in-season newsroom".
    //
    // The three weekday social crons (13:00 / 16:00 / 19:00 UTC: auction, snake
    // and best-ball insight threads) are retired for the regular season and are
    // NOT here; scheduled() still recognizes their strings and refuses to post
    // in the regular season unless DRAFT_SEASON_SOCIAL=1. Put them back for 2027.
    "crons": ["*/15 * * * *"]
  }
}
