{
  "name": "iron-tuna",
  "main": "_worker.js",
  "compatibility_date": "2025-05-01",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  // Automated newsroom prose is pinned separately so a future interactive-model
  // upgrade cannot spend Opus on stories or move numeric work into the LLM.
  "vars": { "LLM_PROVIDER": "anthropic", "LLM_MODEL": "claude-sonnet-4-6", "NEWSROOM_LLM_MODEL": "claude-sonnet-4-6", "POST_DRAFT_OPEN": "1", "TMS_ENABLED": "1", "TMS_PROVIDER": "propline", "PROPLINE_MOVEMENT": "0", "TMS_INTERVAL_MINUTES": "60" },
  // CPU time per invocation. The account was on the Workers FREE plan until
  // 2026-10-10: 10 ms of CPU per request and per cron invocation, no way to
  // raise it, and `limits` refused at deploy (build db0e0105, 2026-09-10).
  // That is what killed the schedule, odds and prop pulls mid-job with no
  // exception (HANDOFF.md §68p, §125). The account is on Workers Paid now,
  // where the default is 30 s and this is the documented maximum. If a
  // deploy ever refuses this stanza again, the plan has lapsed: fix the
  // plan, do not remove the stanza.
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [
    { "binding": "LEADS_DB", "database_name": "iron-tuna-leads", "database_id": "75f7c43a-69cc-48eb-aa78-6ecfd91af2fb" }
  ],
  "triggers": {
    // ONE trigger: the quarter-hour tick. scheduled() in _worker.js hands it to
    // runScheduledTick, which reads JOB_SCHEDULE in New York time (days, hours
    // and quarter-hour minutes) and runs what is due through the job log, then
    // the content desk. The quarter-hour cadence is what makes a Sunday 12:15 PM
    // and a 7:30 PM editorial slot possible in Eastern time without a UTC cron
    // that drifts an hour every November. See HANDOFF.md "The in-season newsroom".
    //
    // The three weekday social crons (13:00 / 16:00 / 19:00 UTC: auction, snake
    // and best-ball insight threads) are retired for the regular season and are
    // NOT here; scheduled() still recognizes their strings and refuses to post
    // in the regular season unless DRAFT_SEASON_SOCIAL=1. Put them back for 2027.
    "crons": ["*/15 * * * *"]
  }
}
